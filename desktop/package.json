{
  "name": "glbandme-desktop",
  "productName": "GLB&ME",
  "version": "1.3.1",
  "description": "Create, sculpt, paint, animate and export GLB models",
  "main": "main/main.js",
  "author": {
    "name": "GLB&ME",
    "email": "terpenesalad@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "lucide-static": "^0.460.0",
    "meshoptimizer": "^0.22.0",
    "opentype.js": "^1.3.4",
    "playwright-core": "^1.48.2",
    "three": "^0.170.0",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "^0.8.3"
  },
  "homepage": "https://github.com/terpenesalad/GLB-ME",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "dist:win": "node scripts/build.mjs && electron-builder --win --x64 --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --publish never",
    "dist:linux": "node scripts/build.mjs && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "app.glbandme.desktop",
    "productName": "GLB&ME",
    "artifactName": "GLB-ME-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 GLB&ME",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "dist/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "glb",
        "name": "GLB model",
        "description": "Binary glTF model",
        "role": "Editor",
        "mimeType": "model/gltf-binary"
      },
      {
        "ext": "gltf",
        "name": "glTF model",
        "description": "glTF model",
        "role": "Editor",
        "mimeType": "model/gltf+json"
      },
      {
        "ext": "obj",
        "name": "OBJ model",
        "role": "Viewer"
      },
      {
        "ext": "stl",
        "name": "STL model",
        "role": "Viewer"
      },
      {
        "ext": "ply",
        "name": "PLY model",
        "role": "Viewer"
      },
      {
        "ext": "fbx",
        "name": "FBX model",
        "role": "Viewer"
      },
      {
        "ext": "dae",
        "name": "Collada model",
        "role": "Viewer"
      },
      {
        "ext": "3mf",
        "name": "3MF model",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "GLB-ME"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GLB&ME",
      "artifactName": "GLB-ME-Setup-${version}.${ext}",
      "uninstallDisplayName": "GLB&ME",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "GLB-ME-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "artifactName": "GLB-ME-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "synopsis": "Create, sculpt, paint, animate and export GLB models",
      "maintainer": "GLB&ME <terpenesalad@users.noreply.github.com>"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "terpenesalad",
        "repo": "GLB-ME",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/terpenesalad/GLB-ME.git"
  }
}
